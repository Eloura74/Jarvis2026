# ================================================
# OMNI / J.A.R.V.I.S. - Configuration Environnement
# ================================================
#
# Ce fichier est un TEMPLATE. Pour configurer votre environnement :
# 1. Copiez ce fichier en .env.local
# 2. Remplacez les valeurs par vos véritables clés
# 3. Ne committez JAMAIS .env.local dans Git
#
# ================================================

# ┌─────────────────────────────────────────────┐
# │  Google Gemini API                          │
# └─────────────────────────────────────────────┘
#
# Clé API pour Google Gemini (IA conversationnelle)
# 
# Pour obtenir votre clé :
# 1. Visitez https://ai.google.dev/
# 2. Connectez-vous avec votre compte Google
# 3. Créez un nouveau projet ou sélectionnez-en un existant
# 4. Générez une clé API
# 5. Copiez-la ci-dessous
#
# Format : AIza...
# IMPORTANT (S1) : La clé est maintenant utilisée UNIQUEMENT côté backend (server/.env.local)
# La variable VITE_GEMINI_API_KEY ci-dessous est OBSOLÈTE — ne plus l'utiliser.
# Ajouter GEMINI_API_KEY=your_api_key_here dans server/.env.local à la place.
#
VITE_GEMINI_API_KEY=OBSOLETE_USE_SERVER_ENV_INSTEAD

# ┌─────────────────────────────────────────────┐
# │  OpenWeatherMap API (Météo)                │
# └─────────────────────────────────────────────┘
#
# Clé API pour OpenWeatherMap (données météo en temps réel)
# 
# Pour obtenir votre clé :
# 1. Visitez https://openweathermap.org/api
# 2. Créez un compte gratuit
# 3. Allez dans "API Keys" de votre profil
# 4. Copiez votre clé API
# 5. Collez-la ci-dessous
#
# Note : Le plan gratuit permet 1000 appels/jour (largement suffisant)
# IMPORTANT : Préfixe VITE_ obligatoire pour exposition côté client
#
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Ville par défaut si géolocalisation refusée (optionnel)
# Exemples : Paris, London, New York, Tokyo
VITE_DEFAULT_WEATHER_CITY=Paris

# ┌─────────────────────────────────────────────┐
# │  Home Assistant (Domotique)                │
# └─────────────────────────────────────────────┘
#
# Token d'accès Home Assistant pour contrôle domotique
# (Optionnel - uniquement si vous utilisez Home Assistant)
#
VITE_HA_TOKEN=your_home_assistant_token_here

# ┌─────────────────────────────────────────────┐
# │  Google Maps API (Navigation)               │
# └─────────────────────────────────────────────┘
#
# Clé API pour Google Maps Directions (temps trajet avec trafic)
# 
# Pour obtenir votre clé :
# 1. Visitez https://console.cloud.google.com/
# 2. Créez un projet ou sélectionnez-en un
# 3. Activez "Directions API"
# 4. Créez une clé API
# 5. Collez-la ci-dessous
#
# Note : 40 000 requêtes/mois gratuites
#
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ┌─────────────────────────────────────────────┐
# │  YouTube Data API (Multimédia)             │
# └─────────────────────────────────────────────┘
#
# Clé API pour YouTube Data v3 (recherche et lecture vidéos)
# 
# Pour obtenir votre clé :
# 1. Visitez https://console.cloud.google.com/
# 2. Activez "YouTube Data API v3"
# 3. Créez une clé API
# 4. Collez-la ci-dessous
#
# Note : 10 000 unités/jour gratuites
#
YOUTUBE_API_KEY=your_youtube_api_key_here

# ┌─────────────────────────────────────────────┐
# │  Spotify Web API (Multimédia)              │
# └─────────────────────────────────────────────┘
#
# Credentials Spotify pour contrôle lecture
# 
# Pour obtenir vos credentials :
# 1. Visitez https://developer.spotify.com/dashboard
# 2. Créez une application
# 3. Copiez Client ID et Client Secret
# 4. Configurez le Refresh Token (voir doc Spotify OAuth)
#
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# ┌─────────────────────────────────────────────┐
# │  Plex Media Server (Multimédia)            │
# └─────────────────────────────────────────────┘
#
# Configuration Plex pour lecture films/séries
# (Optionnel - uniquement si vous utilisez Plex)
#
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here

# ┌─────────────────────────────────────────────┐
# │  TrueNAS API (Monitoring)                  │
# └─────────────────────────────────────────────┘
#
# Configuration TrueNAS pour monitoring NAS
# (Optionnel - uniquement si vous utilisez TrueNAS)
#
TRUENAS_URL=http://truenas.local
TRUENAS_API_KEY=your_truenas_api_key_here

# ┌─────────────────────────────────────────────┐
# │  KDE Connect (Smartphone)                  │
# └─────────────────────────────────────────────┘
#
# Configuration KDE Connect pour contrôle smartphone Android
# (Optionnel - uniquement si vous utilisez KDE Connect)
#
KDE_CONNECT_URL=http://localhost:1716
KDE_CONNECT_DEVICE_ID=your_device_id_here

# ┌─────────────────────────────────────────────┐
# │  Home Assistant (Sécurité)                 │
# └─────────────────────────────────────────────┘
#
# Configuration Home Assistant pour sécurité (alarme, caméras)
# (Optionnel - uniquement si vous utilisez Home Assistant)
#
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_home_assistant_token_here

# ┌─────────────────────────────────────────────┐
# │  Gemini Vision API (Vision)                │
# └─────────────────────────────────────────────┘
#
# Clé API Gemini pour analyse images webcam
# (Utilise la même clé que GEMINI_API_KEY)
# Note : 1500 requêtes/jour gratuites
#
# Pas de variable supplémentaire nécessaire - utilise GEMINI_API_KEY
